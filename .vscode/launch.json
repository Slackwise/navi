{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Navi Worker",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "cwd": "${workspaceFolder}",
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "preLaunchTask": "Start Navi Stack",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Navi Desktop (Deno)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend/desktop",
      "runtimeExecutable": "deno",
      "runtimeArgs": ["run", "--inspect-wait", "--allow-all", "out/main.js"],
      "attachSimplePort": 9229,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "preLaunchTask": "Watch Desktop (Shadow-CLJS)",
      "console": "integratedTerminal"
    }
  ]
}
