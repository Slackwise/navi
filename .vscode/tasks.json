{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Bootstrap Dev Environment",
			"type": "process",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/bootstrap.sh"
			],
			"windows": {
				"command": "${env:ProgramFiles}\\Git\\bin\\bash.exe"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Watch Shadow-CLJS",
			"type": "shell",
			"command": "npx shadow-cljs watch worker",
			"isBackground": true,
			"problemMatcher": {
				"owner": "clojure",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Compiling",
					"endsPattern": "Build completed"
				}
			}
		},
		{
			"label": "Start Wrangler (Debug)",
			"type": "shell",
			"command": "npx wrangler dev --inspect",
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "wrangler",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting local server",
					"endsPattern": "Ready on"
				}
			}
		},
		{
			"label": "Start Navi Stack",
			"dependsOn": [
				"Watch Shadow-CLJS",
				"Start Wrangler (Debug)"
			],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"label": "Run Tests",
			"type": "shell",
			"command": "npm test",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Watch Desktop (Shadow-CLJS)",
			"type": "shell",
			"command": "npx shadow-cljs watch desktop",
			"isBackground": true,
			"problemMatcher": {
				"owner": "clojure",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Compiling",
					"endsPattern": "Build completed"
				}
			}
		},
		{
			"label": "Build Desktop (Node.js)",
			"type": "shell",
			"command": "npx shadow-cljs release desktop",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Package Desktop (Node.js SEA)",
			"type": "shell",
			"command": "npm run desktop:package",
			"dependsOn": [
				"Build Desktop (Node.js)"
			],
			"problemMatcher": []
		},
		{
			"label": "Run Desktop (Node.js)",
			"type": "shell",
			"command": "npm start",
			"options": {
				"cwd": "${workspaceFolder}/frontend/desktop"
			},
			"dependsOn": [
				"Watch Desktop (Shadow-CLJS)"
			],
			"problemMatcher": []
		}
	]
}