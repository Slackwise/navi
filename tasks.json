{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Shadow-CLJS",
      "type": "shell",
      "command": "npx shadow-cljs watch worker",
      "isBackground": true,
      "problemMatcher": {
        "owner": "clojure",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling",
          "endsPattern": "Build completed"
        }
      }
    },
    {
      "label": "Start Wrangler (Debug)",
      "type": "shell",
      "command": "npx wrangler dev --inspect",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "wrangler",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting local server",
          "endsPattern": "Ready on"
        }
      }
    },
    {
      "label": "Watch Desktop (Shadow-CLJS)",
      "type": "shell",
      "command": "npx shadow-cljs watch desktop",
      "isBackground": true,
      "problemMatcher": {
        "owner": "clojure",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling",
          "endsPattern": "Build completed"
        }
      }
    },
    {
      "label": "Run Desktop (Deno)",
      "type": "shell",
      "command": "deno task dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend/desktop"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Navi Stack",
      "dependsOn": [
        "Watch Shadow-CLJS",
        "Start Wrangler (Debug)"
      ],
      "dependsOrder": "parallel"
    }
  ]
}