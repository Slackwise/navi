{:source-paths ["shared/src"
                "shared/test"
                "backend/src"
                "backend/test"
                "frontend/desktop/src"]
 :dependencies []
 :builds
 {;; Cloudflare Worker (backend/wrangler.toml points at backend/out/worker.js)
  :worker {:target :esm
           :output-dir "backend/out"
           :modules {:worker {:entries [navi.core]}}
           :js-options {:js-provider :import}}

  ;; Node.js desktop tray app; Koffi binds Win32 functions by their native symbol names.
  :desktop {:target :esm
            :output-dir "frontend/desktop/out"
            :modules {:main {:init-fn navi.desktop.main/main}}
            :js-options {:js-provider :import}
            :devtools {:enabled false}
            :compiler-options {:optimizations :simple}}

  ;; Runs every *-test namespace from shared/test and backend/test under Node
  :test {:target :node-test
         :output-to "out/node-tests.js"
         :autorun true}}}
